# Eine Instanz = eine Datei sites/<name>.env (Name: kleinbuchstaben, ziffern, - _)
# Wird nur auf dem Proxy-Host angelegt, nie committet (.gitignore).
#   cp sites/_beispiel.env.example sites/<name>.env
# Pflicht:
DOMAIN=profi.example.com
BACKEND=192.0.2.10:28080       # JBoss intern: 8080 + Portversatz

# Optional (Vorgaben):
LISTEN_PORT=443                # externer Port; bei mehreren Instanzen auf einer
                               # Domain je Instanz ein eigener (z. B. 8443 + Versatz)
APP_PATH=/profi/               # nur dieser Pfad wird weitergeleitet
CLIENT_MAX_BODY_SIZE=50m       # größte Anfrage (Uploads)
CHECK_APP=1                    # cert-check.sh prüft APP_PATH auf Antwort 2xx/3xx
HSTS=0                         # Sekunden, 0 = aus. Erst einschalten, wenn der
                               # Rückweg auf HTTP nicht mehr gebraucht wird
                               # (Browser merken sich HSTS bis zum Ablauf).
                               # Üblich danach: 31536000 (1 Jahr)
