# Einstellungen DIESES Proxy-Hosts. Kopieren nach host.env (bleibt lokal,
# steht nicht im Repo).

# Welche Instanzen aus sites/ bedient dieser Host? Leerzeichen-getrennt.
SITES=kunde

# Konto bei Let's Encrypt (Ablaufwarnungen gehen hierhin)
ACME_EMAIL=admin@example.com

# Empfänger der Fehlermails (Versand über msmtp, /etc/msmtprc)
MAIL_AN=admin@example.com

# Warnen, wenn ein Zertifikat weniger als so viele Tage gültig ist
WARN_DAYS=20

# IPv6 zusätzlich lauschen: auto (wenn der Host IPv6 hat), 1 oder 0.
# Wichtig, wenn die Domain einen AAAA-Eintrag hat - Let's Encrypt prüft
# dann bevorzugt über IPv6.
IPV6=auto

# Optional: Images abweichend von compose.yaml.
# Gilt nur über die Skripte - ein direktes "docker compose up -d" sieht
# diese Werte nicht (siehe docs/fallen.md).
#NGINX_IMAGE=nginx:1.30.7-alpine
#CERTBOT_IMAGE=certbot/certbot:v5.7.0
